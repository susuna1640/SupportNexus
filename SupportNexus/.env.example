# SupportNexus 环境变量示例
# 复制为 .env 后填入你自己的值；不要提交 .env。

# ── 模型服务 ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=

# ── 回复长度 ──────────────────────────────────────────────────────────────────
# 可按 Agent 用 SUPPORT_NEXUS_API_MAX_TOKENS、SUPPORT_NEXUS_TECHNICAL_MAX_TOKENS 等单独覆盖。
SUPPORT_NEXUS_AGENT_MAX_TOKENS=
SUPPORT_NEXUS_COMPOSER_MAX_TOKENS=

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=
LOG_LEVEL=
API_HOST=
API_PORT=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=
CHROMA_PORT=
CHROMA_PERSIST_DIRECTORY=

# ── 监控与可观测性 ────────────────────────────────────────────────────────────
PROMETHEUS_PORT=
MONITOR_INTERVAL=
ALERT_WEBHOOK_URL=
LANGFUSE_BASE_URL=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_TRACING_ENABLED=
LANGFUSE_CAPTURE_CONTENT=

# ── DashScope ────────────────────────────────────────────────────────────────
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=

# ── 意图识别 ──────────────────────────────────────────────────────────────────
SUPPORT_NEXUS_INTENT_EMBEDDING_MODEL=
SUPPORT_NEXUS_INTENT_EMBEDDING_DIMENSIONS=
